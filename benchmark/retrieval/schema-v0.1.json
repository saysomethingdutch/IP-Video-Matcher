{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipvm:retrieval-characterization:v0.1",
  "title": "Phase 2A-0 Retrieval Characterization",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "measurement_only",
    "configuration",
    "aggregate",
    "by_episode",
    "by_query_mode",
    "by_source_position_bucket",
    "by_source_phase_bucket",
    "by_interval",
    "sampling_audit",
    "observed_threshold_band",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": "retrieval-characterization-v0.1"},
    "scope": {"const": "phase2a_0_retrieval_characterization"},
    "measurement_only": {"const": true},
    "contains_media_identity": {"const": false},
    "configuration": {
      "type": "object",
      "required": ["source_fps", "query_fps", "top_k_values", "tolerance_seconds"],
      "properties": {
        "source_fps": {"const": 2.0},
        "query_fps": {"const": 2.0},
        "top_k_values": {"const": [1, 8, 32, 128]},
        "tolerance_seconds": {"type": "number", "minimum": 0},
        "query_modes": {
          "type": "array",
          "items": {"enum": ["direct", "reencode"]},
          "uniqueItems": true,
          "minItems": 1
        },
        "source_grid_period_seconds": {"const": 0.5},
        "phase_bucket_count": {"const": 10},
        "source_position_bucket_count": {"const": 5}
      }
    },
    "aggregate": {
      "type": "object",
      "required": [
        "query_frame_count",
        "retrieval_recall_at_k",
        "correct_source_rank_distribution",
        "median_rank",
        "p90_rank",
        "score_margin"
      ]
    },
    "by_episode": {"type": "object"},
    "by_query_mode": {"type": "object"},
    "by_source_position_bucket": {"type": "object"},
    "by_source_phase_bucket": {"type": "object"},
    "by_interval": {"type": "object"},
    "sampling_audit": {
      "type": "object",
      "required": [
        "all_query_frames_off_source_grid",
        "minimum_distance_from_source_grid_seconds",
        "query_subframe_phase_values_seconds",
        "source_subframe_phase_range_seconds",
        "interval_count_by_episode",
        "interval_count_by_source_position_bucket",
        "interval_count_by_source_phase_bucket"
      ]
    },
    "observed_threshold_band": {
      "enum": [
        "RECALL_AT_8_GTE_95_PERCENT",
        "RECALL_AT_8_LT_95_BUT_AT_32_OR_128_GTE_95_PERCENT",
        "RECALL_AT_128_LT_95_PERCENT"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "episode",
          "interval_id",
          "query_mode",
          "query_timestamp",
          "expected_source_timestamp",
          "normalized_source_start",
          "source_position_bucket",
          "query_subframe_phase_seconds",
          "source_subframe_phase_seconds",
          "source_query_temporal_phase",
          "source_phase_bucket",
          "correct_source_rank",
          "score_margin",
          "hits"
        ]
      }
    },
    "decision": {"type": "null"}
  },
  "additionalProperties": true
}
