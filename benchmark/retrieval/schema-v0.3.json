{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipvm:retrieval-characterization:v0.3",
  "title": "Phase 2A-0 Retrieval Characterization v0.3",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "measurement_only",
    "configuration",
    "aggregate",
    "profiles",
    "profile_status",
    "by_episode",
    "by_query_mode",
    "by_source_position_bucket",
    "by_source_phase_bucket",
    "by_interval",
    "sampling_audit",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "retrieval-characterization-v0.3"
    },
    "scope": {
      "const": "phase2a_0_retrieval_characterization"
    },
    "measurement_only": {
      "const": true
    },
    "contains_media_identity": {
      "const": false
    },
    "configuration": {
      "type": "object",
      "required": [
        "alignment_usable_grid_steps",
        "alignment_usable_tolerance_seconds",
        "cluster_bootstrap",
        "query_fps",
        "query_profiles",
        "readiness_gate_metric",
        "source_fps",
        "source_grid_period_derivation",
        "source_grid_period_seconds",
        "threshold",
        "tolerance_seconds",
        "top_k_values"
      ],
      "properties": {
        "source_fps": {
          "const": 2.0
        },
        "query_fps": {
          "const": 2.0
        },
        "top_k_values": {
          "const": [
            1,
            8,
            32,
            128
          ]
        },
        "tolerance_seconds": {
          "type": "number",
          "minimum": 0
        },
        "alignment_usable_tolerance_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "alignment_usable_grid_steps * source_grid_period_seconds."
        },
        "alignment_usable_grid_steps": {
          "const": 1
        },
        "query_profiles": {
          "type": "array",
          "items": {
            "enum": [
              "direct",
              "reencode",
              "p1",
              "p2",
              "p3"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "source_grid_period_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Derived as 1.0 / matching.coarse_fps. Not a hardcoded constant."
        },
        "phase_bucket_count": {
          "const": 10
        },
        "source_position_bucket_count": {
          "const": 5
        },
        "cluster_bootstrap": {
          "type": "object",
          "required": [
            "iterations",
            "seed",
            "level"
          ],
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer"
            },
            "level": {
              "const": 0.95
            }
          }
        },
        "threshold": {
          "const": 0.95
        },
        "source_grid_period_derivation": {
          "const": "1.0 / matching.coarse_fps"
        },
        "readiness_gate_metric": {
          "const": "alignment_usable_recall_at_8"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "required": [
        "query_frame_count",
        "retrieval_recall_at_k",
        "alignment_usable_recall_at_k",
        "adjacent_grid_only_miss_rate_at_k",
        "true_retrieval_loss_rate_at_k",
        "correct_source_rank_distribution",
        "median_rank",
        "p90_rank",
        "score_margin"
      ]
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "query_frame_count",
          "interval_count",
          "distinct_content_position_count",
          "nominal_query_frame_count",
          "aggregate",
          "strict",
          "alignment_usable",
          "strict_threshold_band",
          "alignment_usable_threshold_band",
          "readiness_gate_metric",
          "readiness_gate_band",
          "cluster_bootstrap_confidence_interval",
          "true_retrieval_loss_rate_at_8",
          "adjacent_grid_only_miss_rate_at_8"
        ],
        "properties": {
          "strict": {
            "type": "object",
            "required": [
              "confidence_interval",
              "intra_cluster_correlation",
              "mean_cluster_size",
              "design_effect",
              "effective_sample_size",
              "threshold_band"
            ],
            "properties": {
              "threshold_band": {
                "enum": [
                  "ABOVE",
                  "STRADDLES",
                  "BELOW",
                  "UNKNOWN"
                ]
              }
            },
            "description": "Cluster inference for ONE metric. Strict and alignment-usable never share statistics."
          },
          "alignment_usable": {
            "type": "object",
            "required": [
              "confidence_interval",
              "intra_cluster_correlation",
              "mean_cluster_size",
              "design_effect",
              "effective_sample_size",
              "threshold_band"
            ],
            "properties": {
              "threshold_band": {
                "enum": [
                  "ABOVE",
                  "STRADDLES",
                  "BELOW",
                  "UNKNOWN"
                ]
              }
            },
            "description": "Cluster inference for ONE metric. Strict and alignment-usable never share statistics."
          },
          "strict_threshold_band": {
            "enum": [
              "ABOVE",
              "STRADDLES",
              "BELOW",
              "UNKNOWN"
            ]
          },
          "alignment_usable_threshold_band": {
            "enum": [
              "ABOVE",
              "STRADDLES",
              "BELOW",
              "UNKNOWN"
            ]
          },
          "readiness_gate_metric": {
            "const": "alignment_usable_recall_at_8"
          },
          "readiness_gate_band": {
            "enum": [
              "ABOVE",
              "STRADDLES",
              "BELOW",
              "UNKNOWN"
            ]
          },
          "threshold_band": {
            "enum": [
              "ABOVE",
              "STRADDLES",
              "BELOW",
              "UNKNOWN"
            ],
            "deprecated": true,
            "description": "DEPRECATED and no longer emitted. It did not name its metric. Use strict_threshold_band or alignment_usable_threshold_band."
          }
        }
      }
    },
    "profile_status": {
      "type": "object"
    },
    "by_episode": {
      "type": "object"
    },
    "by_query_mode": {
      "type": "object"
    },
    "by_source_position_bucket": {
      "type": "object"
    },
    "by_source_phase_bucket": {
      "type": "object"
    },
    "by_interval": {
      "type": "object"
    },
    "sampling_audit": {
      "type": "object",
      "required": [
        "all_query_frames_off_source_grid",
        "minimum_distance_from_source_grid_seconds",
        "source_subframe_phase_range_seconds",
        "distinct_content_position_count",
        "interval_count_by_episode",
        "interval_count_by_source_position_bucket",
        "interval_count_by_source_phase_bucket"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "episode",
          "interval_id",
          "query_mode",
          "query_timestamp",
          "expected_source_timestamp",
          "normalized_source_start",
          "source_position_bucket",
          "query_subframe_phase_seconds",
          "source_subframe_phase_seconds",
          "source_query_temporal_phase",
          "source_phase_bucket",
          "correct_source_rank",
          "score_margin",
          "hits",
          "alignment_usable_hits"
        ]
      }
    },
    "decision": {
      "type": "null"
    }
  },
  "additionalProperties": true,
  "x-readiness-gate": {
    "metric": "alignment_usable_recall_at_8",
    "band_field": "profiles.<profile>.alignment_usable_threshold_band",
    "note": "ADR-0005: strict recall is a localization diagnostic and does not gate Temporal Alignment v2."
  },
  "x-interpretation-limit": "Transcode profiles vary compression, resolution and codec only. Those perturbations fall below the main sensitivity range of the current low-frequency DCT descriptor and must not be generalized to crop, mirror, subtitle overlay, picture-in-picture, or camera capture robustness."
}
